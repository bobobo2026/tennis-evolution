# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML: always revalidate, the copy changes more often than the hashes.
/
  Cache-Control: public, max-age=0, must-revalidate

/zh/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Single CSS/JS bundle per page; keep the window short so a deploy is visible fast.
/styles.css
  Cache-Control: public, max-age=600, must-revalidate

/app.js
  Cache-Control: public, max-age=600, must-revalidate

# Demo media and images.
/assets/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
